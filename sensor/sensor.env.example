# GDEF-L1NK sensor configuration. Copy to sensor.env and fill in.
# Register the device on the hub UI first (Devices -> Add) to obtain its
# DEVICE_ID and DEVICE_KEY — the key is shown exactly once.
# Keep this file private (chmod 600): DEVICE_KEY authenticates the sensor.

# Hub base URL (the central GDEF-L1NK dashboard).
CENTRAL_URL=http://hub.lan:8000

# Device identity issued by the hub.
DEVICE_ID=
DEVICE_KEY=

# Interface to capture on (e.g. eth0, enp3s0). Leave unset for the scapy default.
NETWORK_INTERFACE=eth0

# --- Optional tuning --------------------------------------------------------
# SENSOR_FLUSH_INTERVAL=2.0      # seconds between pushes to the hub
# SENSOR_MAX_BUFFER_IPS=20000    # cap buffered IPs (drop-oldest beyond this)
# SENSOR_MAX_EVENTS=5000         # max events per batch
# SENSOR_SHOW_ALL_UDP=0          # 1 = include noisy discovery UDP (NetBIOS/SSDP/mDNS)
# SENSOR_HTTP_TIMEOUT=10
# SENSOR_VERIFY_TLS=1            # 0 = skip TLS verify (self-signed hub on a trusted LAN)
# LOG_LEVEL=INFO
