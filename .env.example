# Copy to .env and adjust. Never commit the real .env (it is gitignored).
# Read by docker compose and ./run.sh.

# --- Capture ----------------------------------------------------------------
# Interface Scapy listens on (e.g. eth0, wlan0, enp3s0). REQUIRED. The app uses
# host networking, so this is a real host interface.
NETWORK_INTERFACE=eth0

# --- Web UI -----------------------------------------------------------------
# 127.0.0.1 = reachable only from the host. Set 0.0.0.0 to expose on the LAN.
APP_HOST=127.0.0.1
APP_PORT=8000

# Login token. If unset, a fresh random token is generated on every start and
# written to database/access_token.txt (retrieve with: ./run.sh token). Set a
# fixed value to keep it stable across restarts (keep this file private).
# ACCESS_TOKEN=choose-your-own-strong-token

# Optional: stable Flask session signing key (otherwise generated).
# FLASK_SECRET_KEY=choose-a-long-random-value

# --- Security ---------------------------------------------------------------
# Geo lookups use local .mmdb files and ipinfo.io (HTTPS) by default. Set to 1
# to also allow the unencrypted http://ip-api.com fallback (leaks queried IPs
# to a third party on the wire).
# ALLOW_INSECURE_GEO_API=0
#
# Enable ONLY when the app sits behind a trusted reverse proxy that overwrites
# client-supplied X-Forwarded-For. Lets the per-IP login lockout and Socket.IO
# rate limit see the real client IP instead of the proxy's.
# TRUST_PROXY=0
# Exact number of trusted proxies in front of the app (only with TRUST_PROXY=1).
# TRUST_PROXY_HOPS=1

# --- Logging & resource limits ----------------------------------------------
# Log verbosity: DEBUG, INFO, WARNING, ERROR. Default INFO. DEBUG is very chatty
# and can fill the disk fast under heavy traffic.
# LOG_LEVEL=INFO
# Write logs to a self-rotating file (in addition to stdout). Leave unset to log
# only to stdout. LOG_MAX_BYTES = size per file before rollover, LOG_BACKUP_COUNT
# = how many rotated files to keep.
# LOG_FILE=app.log
# LOG_MAX_BYTES=10485760
# LOG_BACKUP_COUNT=5
#
# Hard ceiling on rows kept in the ip_data table. The cleanup thread trims the
# oldest unpinned rows beyond this so a spoofing flood can't fill the disk.
# MAX_IP_ROWS=50000
#
# Display / "active" window (seconds): how long a point stays visible in the
# live globe (dot fade-out, initial load, active-connection count). Raise this
# to keep older points on the map longer. Default 3600 (1h).
# EXPIRATION_SECONDS=3600
#
# DB retention window (seconds): how long a row is KEPT in ip_data before the
# cleanup thread deletes it (pinned IPs are never deleted). Decoupled from the
# display window above, so data is retained for history long after a point stops
# being drawn. Clamped to be >= EXPIRATION_SECONDS. Default 2592000 (30 days).
# RETENTION_SECONDS=2592000

# --- PostgreSQL (db container) ----------------------------------------------
POSTGRES_USER=gdef_l1nk
# CHANGE THIS to a strong secret before any real deployment.
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=gdef_l1nk
# Host port the db container publishes (loopback only). 55432 avoids clashing
# with a system PostgreSQL already listening on 5432.
POSTGRES_PORT=55432
