# Copy to .env and adjust. Never commit the real .env (it is gitignored).

# --- Capture ----------------------------------------------------------------
# Interface Scapy listens on (e.g. eth0, wlan0, enp3s0). REQUIRED.
NETWORK_INTERFACE=eth0

# --- Web UI -----------------------------------------------------------------
# 127.0.0.1 = reachable only from the host. Set 0.0.0.0 to expose on the LAN.
APP_HOST=127.0.0.1
APP_PORT=8000

# --- PostgreSQL (Docker stack) ----------------------------------------------
POSTGRES_USER=connectspoofer
# CHANGE THIS to a strong secret before any real deployment.
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=connectspoofer
POSTGRES_PORT=5432

# --- Bare-metal database (run.sh, no Docker) --------------------------------
# How the app reaches the database. Note: a system PostgreSQL often already
# occupies 5432, so the run.sh-managed local cluster uses 54329 to avoid clashes.
DATABASE_URL=postgresql://connectspoofer:connectspoofer@127.0.0.1:54329/connectspoofer

# Let run.sh manage a private PostgreSQL cluster: started on `./run.sh start`,
# stopped on `./run.sh stop`. Under sudo it runs as $SUDO_USER (PostgreSQL can't
# run as root). Set to 0 if you point DATABASE_URL at an external/remote DB.
MANAGE_LOCAL_DB=1
DB_PORT=54329
DB_NAME=connectspoofer
DB_USER=connectspoofer
DB_PASSWORD=connectspoofer
# PGDATA_LOCAL=$HOME/.local/share/connectspoofer-pg   # cluster location (auto)
# PG_CTL=/usr/lib/postgresql/16/bin/pg_ctl            # if pg binaries aren't found
