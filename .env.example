# Copy to .env and adjust. Never commit the real .env (it is gitignored).
# Read by docker compose and ./run.sh.

# --- Capture ----------------------------------------------------------------
# Interface Scapy listens on (e.g. eth0, wlan0, enp3s0). REQUIRED. The app uses
# host networking, so this is a real host interface.
NETWORK_INTERFACE=eth0

# --- Web UI -----------------------------------------------------------------
# 127.0.0.1 = reachable only from the host. Set 0.0.0.0 to expose on the LAN.
APP_HOST=127.0.0.1
APP_PORT=8000

# Login token. If unset, a fresh random token is generated on every start and
# written to database/access_token.txt (retrieve with: ./run.sh token). Set a
# fixed value to keep it stable across restarts (keep this file private).
# ACCESS_TOKEN=choose-your-own-strong-token

# Optional: stable Flask session signing key (otherwise generated).
# FLASK_SECRET_KEY=choose-a-long-random-value

# --- PostgreSQL (db container) ----------------------------------------------
POSTGRES_USER=connectspoofer
# CHANGE THIS to a strong secret before any real deployment.
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=connectspoofer
# Host port the db container publishes (loopback only). 55432 avoids clashing
# with a system PostgreSQL already listening on 5432.
POSTGRES_PORT=55432
